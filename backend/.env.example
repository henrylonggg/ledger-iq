# Server-side OpenAI key. Used for extraction, scoring, the narrative and the summary.
# Keep the real value in backend/.env (git-ignored) or your host's environment — never commit it,
# and it is never sent to the browser.
DEMO_API_KEY=sk-your-openai-key-here
PORT=3001

# Optional
# OPENAI_MODEL=gpt-4o-mini
# Comma-separated models to fall back to if the primary is rate limited (separate per-model limits)
# OPENAI_FALLBACK_MODELS=gpt-4.1-mini
